// T1 - load-use hazard, as built.
//
// Scenario: addi x5,x5,1 ; addi x7,x7,1 ; lw x1,0(x2) ; add x3,x1,x4 ; sub x8,x9,x10 ;
//           then three unrelated addi instructions (I1..I3).
//
// rtl/control.sv:190-196 (rs1 consumer) and :214-220 (rs2 / store-data consumer):
// when the load is in MA and a dependent consumer is in EX, control sets
// ex_ma_flush = 1, if_id_clk_en = 0 and id_ex_clk_en = 0. It does NOT touch
// ex_ma_clk_en or ma_wb_clk_en (contrast rtl/control.sv:246-251, the data-wait stall,
// which clears all four). The consumer is held in EX, EX/MA receives a NOP.
//
// rtl/control.sv:186-188: in the next cycle the load is in WB and the held consumer
// selects RD_WB_S1, so the value arrives through the write-back forward, not the
// register file.
//
// rtl/riscv_small.sv:142 wires reg_file.clk_en to id_ex_clk_en, so the write of the
// instruction resident in WB during the stall cycle (I0, addi x7) is suppressed: G-19.
{
  signal: [
    { name: 'clk',          wave: 'p......' },
    { name: 'if_id_clk_en', wave: '1.01...' },
    { name: 'id_ex_clk_en', wave: '1.01...' }, // also reg_file.clk_en
    { name: 'ex_ma_clk_en', wave: '1......' },
    { name: 'ma_wb_clk_en', wave: '1......' },
    { name: 'ex_ma_flush',  wave: '0.1....' },
    { name: 'inst_id',      wave: '234.567', data: ['LW', 'ADD', 'SUB', 'I1', 'I2', 'I3'] },
    { name: 'rd0_wr_en_ma', wave: '1..01..' },
    { name: 'rd0_wr_en_wb', wave: '1...01.' }, // cycle 3: I0 valid but not written
    { name: 'alu_src1',     wave: '2..32..', data: ['RS1_S1', 'RD_WB_S1', 'RS1_S1'] },
  ],
  head: {
    text: 'T1 load-use: IF/ID and ID/EX hold, EX/MA is flushed, the WB forward carries the value',
    tick: 1,
    every: 1,
  },
  foot: { text: 'doc/figs/wave/t1-load-use-stall.json5' },
  config: { hscale: 3 },
}
