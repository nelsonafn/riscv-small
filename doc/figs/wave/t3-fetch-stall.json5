// T3 - the instruction grant withheld, as built (G-09).
//
// rtl/control.sv:263-265: !inst_ready raises if_id_flush and nothing else. Every stage
// enable stays 1, pc_sel stays PC_PLUS4 and if_id_flush defaults to 0
// (rtl/control.sv:107-113); inst_rd_en stays 1 for every cycle, never deasserted
// (rtl/control.sv:115, inside the same defaults block :107-115).
// rtl/instruction_fetch.sv:74-89 / :100-113: every enabled edge loads IF/ID from
// (pc_fetch, inst_data) and advances the PC, whether or not the memory granted the fetch.
//
// Fetch latency as built: the memory answers one cycle after the address is presented, so
// the pair IF/ID would take at the edge ending cycle N belongs to the address presented in
// cycle N-1, which is exactly what pc_fetch carries (rtl/instruction_fetch.sv:74-89). A
// withheld grant in cycle N therefore discards the instruction addressed in cycle N-1, and
// pc_id(N+1) is the zero word, not the dropped instruction.
//
// Result: with inst_ready low in cycles 3 and 4 the words at 0x104 and 0x108 are dropped
// and never execute; the PC runs on to 0x10C, the first instruction to reach ID after the
// gap (cycle 6). This is not a wait state and it is not FR-28: no fetch is held
// (doc/verification.md G-09).
{
  signal: [
    { name: 'clk',          wave: 'p......' },
    { name: 'pc',           wave: '=======', data: ['0x100', '0x104', '0x108', '0x10C', '0x110', '0x114', '0x118'] },
    { name: 'pc_fetch',     wave: '=======', data: ['0x0FC', '0x100', '0x104', '0x108', '0x10C', '0x110', '0x114'] },
    { name: 'inst_rd_en',   wave: '1......' },
    { name: 'inst_ready',   wave: '1.0.1..' },
    { name: 'if_id_flush',  wave: '0.1.0..' },
    { name: 'if_id_clk_en', wave: '1......' },
    { name: 'pc_id',        wave: '=======', data: ['0x0F8', '0x0FC', '0x100', '0', '0', '0x10C', '0x110'] },
  ],
  head: {
    text: 'T3 inst_ready low: only IF/ID is flushed, the PC keeps advancing, the fetch is dropped',
    tick: 1,
    every: 1,
  },
  foot: { text: 'doc/figs/wave/t3-fetch-stall.json5' },
  config: { hscale: 2 },
}
